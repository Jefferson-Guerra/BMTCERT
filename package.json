{
  "name": "ssl-manager",
  "version": "1.0.0",
  "description": "Gestor de certificados SSL: carga, decodificacion, generacion de cadenas, PFX, JKS y validacion de pares",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "node-forge": "^1.3.1"
  },
  "build": {
    "appId": "com.local.sslmanager",
    "productName": "SSL Manager",
    "files": [
      "**/*"
    ],
    "asarUnpack": [
      "data/**/*"
    ],
    "icon": "build/icon.ico",
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}